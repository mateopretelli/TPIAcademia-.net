@using DTOs
@using ApiClients
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            s
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar</text>
                        }
                        else
                        {
                            <text>Editar</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentSection" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentSection.ID" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Descripción *</label>
                            <InputText @bind-Value="currentSection.Description" class="form-control" />
                            @if (validationErrors.ContainsKey("Description"))
                            {
                                <div class="text-danger small">@validationErrors["Description"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Año especialidad *</label>
                            <InputSelect @bind-Value="currentSection.SpecialtyYear" class="form-select">
                                <option value="0">Seleccionar año especialidad</option>
                                @if (sections != null)
                                {
                                    @foreach (var sect in sections)
                                    {
                                        <option value="@sect.ID">@sect.SpecialtyYear</option>
                                    }
                                }
                            </InputSelect>
                            @if (validationErrors.ContainsKey("Section"))
                            {
                                <div class="text-danger small">@validationErrors["Section"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSectionChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private SectionDTO currentSection = new SectionDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();
    private List<SectionDTO>? sections;

    public enum FormMode
    {
        Add,
        Update
    }

    public async Task ShowAddModal()
    {
        mode = FormMode.Add;
        currentSection = new SectionDTO();
        await LoadSections();
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public void ShowEditModal(SectionDTO section)
    {
        mode = FormMode.Update;
        currentSection = new SectionDTO
            {
                ID = section.ID,
                Description = section.Description,

            };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateSection())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            SectionApiClient client = new SectionApiClient();

            if (mode == FormMode.Add)
            {
                await SectionApiClient.AddAsync(currentSection);
            }
            else
            {
                await SectionApiClient.UpdateAsync(currentSection);
            }

            await OnSectionChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateSection()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentSection.Description))
        {
            validationErrors["Description"] = "La descripción es requerida";
            isValid = false;
        }
        else if (currentSection.SpecialtyYear == 0)
        {
            validationErrors["SpecialtyYear"] = "Seleccione un año de especialidad";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private async Task LoadSections()
    {
        try
        {
            sections = (await SectionApiClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar comisiones: {ex.Message}";
        }
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}