@page "/specialties"
@using DTOs
@using ApiClients
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@inherits Blazor.Server.Auth.AuthenticatedComponentBase
@attribute [Authorize]
@inject IJSRuntime JSRuntime

<PageTitle>Specialties</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Especialidades</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            <div class="mb-3">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <i class="fas fa-plus"></i> Agregar
                </button>
            </div>

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Descripción</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (specialties != null && specialties.Any())
                            {
                                @foreach (var specialty in specialties)
                                {
                                    <tr>
                                        <td>@specialty.ID</td>
                                        <td>@specialty.Description</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(specialty)">
                                                <i class="fas fa-edit"></i> Editar
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(specialty)">
                                                <i class="fas fa-trash"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center">No hay especialidades registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<SpecialtyModal @ref="specialtyModal" OnSpecialtyChanged="LoadSpecialties" />

@code {
    private List<SpecialtyDTO>? specialties;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private SpecialtyModal specialtyModal = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadSpecialties();
    }

    private async Task LoadSpecialties()
    {
        try
        {
            loading = true;
            specialties = (await SpecialtyApiClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar especialidades: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        specialtyModal.ShowAddModal();
    }

    private void OpenEditModal(SpecialtyDTO specialty)
    {
        specialtyModal.ShowEditModal(specialty);
    }

    private async Task ConfirmDelete(SpecialtyDTO specialty)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar la especialidad {specialty.ID} {specialty.Description}?");

        if (confirm)
        {
            await DeleteSpecialty(specialty.ID);
        }
    }

    private async Task DeleteSpecialty(int id)
    {
        try
        {
            await SpecialtyApiClient.DeleteAsync(id);
            successMessage = "Especialidad eliminada exitosamente.";
            await LoadSpecialties();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar especialidad: {ex.Message}";
        }
    }
}
