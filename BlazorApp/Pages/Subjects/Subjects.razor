@page "/subjects"
@using DTOs
@using ApiClients
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime

<PageTitle>>Subjects</PageTitle>
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Subjects</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            <div class="mb-3">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <i class="fas fa-plus"></i> Agregar
                </button>
            </div>

            @if(loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Descripción</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (subjects != null && subjects.Any())
                            {
                                @foreach (var subject in subjects)
                                {
                                    <tr>
                                        <td>@subject.ID</td>
                                        <td>@subject.Description</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-secondary me-2" @onclick="() => OpenEditModal(subject)">
                                                <i class="fas fa-edit"></i> Editar
                                            </button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(subject)">
                                                <i class="fas fa-trash-alt"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center">No hay materias disponibles.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>


@code {
    private List<SubjectDTO>? subjects;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private SubjectModal subjectModal = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubjects();
    }

    private async Task LoadSubjects()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;
            subjects = (await SubjectApiClient.GetAllAsync()).ToList();
            successMessage = string.Empty; // Clear success message when reloading
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando materias: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenAddModal()
    {
        subjectModal.ShowAddModal();
    }

    private void OpenEditModal(SubjectDTO subject)
    {
        subjectModal.ShowEditModal(subject);
    }

    private async Task ConfirmDelete(SubjectDTO subject)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar la materia '{subject.Description}'?");
        if (confirm)
        {
            await DeleteSubject(subject.ID);
        }
    }

    private async Task DeleteSubject(int subjectId)
    {
        try
        {
            await SubjectApiClient.DeleteAsync(subjectId);
            successMessage = "Materia eliminada exitosamente.";
            await LoadSubjects();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error eliminando materia: {ex.Message}";
        }

    }
}
